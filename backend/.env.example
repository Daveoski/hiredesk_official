# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hiredesk

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudinary (CV uploads). Needed for the public application endpoint.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails). Leave RESEND_API_KEY empty to skip sending emails in development.
# Resend's test sender onboarding@resend.dev only delivers to the Resend account's own address;
# verify your domain in Resend to email anyone (then e.g. EMAIL_FROM=HireDesk <team@yourdomain.com>).
RESEND_API_KEY=
EMAIL_FROM=HireDesk <onboarding@resend.dev>

# Optional: send through SMTP instead of Resend (used when SMTP_HOST is set). Works without a domain.
# Gmail: turn on 2-Step Verification, create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Google Identity Services sign-in (use the same OAuth client ID in frontend/.env.local).
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
