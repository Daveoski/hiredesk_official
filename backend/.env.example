# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hiredesk

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudinary (CV uploads). Needed for the public application endpoint.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails). Leave RESEND_API_KEY empty to skip sending emails in development.
RESEND_API_KEY=
EMAIL_FROM=HireDesk <onboarding@resend.dev>
